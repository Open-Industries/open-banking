####
# Containerfile — Loan Service
# Multi-stage build (12-Factor V: Build, Release, Run are strictly separated).
# Build:  mvn -pl services/loan-service package
# Image:  podman build -f services/loan-service/src/main/docker/Dockerfile.jvm -t loan-service services/loan-service
####
FROM registry.access.redhat.com/ubi9/openjdk-21:1.20 AS build
WORKDIR /work
COPY . /work
USER 0
RUN mvn -q -pl services/loan-service -am package -DskipTests

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.20
ENV LANGUAGE='en_US:en'
COPY --from=build --chown=185 /work/services/loan-service/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /work/services/loan-service/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /work/services/loan-service/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /work/services/loan-service/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8086
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
